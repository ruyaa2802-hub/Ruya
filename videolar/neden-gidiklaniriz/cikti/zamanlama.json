   },
   "cumleler": [
    {
     "metin": "Kendinizi gıdıklamayı hiç denediniz mi?",
     "start": 1.6,
     "end": 3.903370786516854
    },
    {
     "metin": "Ne kadar uğraşırsanız uğraşın, işe yaramaz.",
     "start": 4.223370786516854,
     "end": 6.841348314606741
    },
    {
     "metin": "Peki neden?",
     "start": 7.161348314606741,
     "end": 7.824269662921347
    }
   ]
  },
  {
   "id": "turler",
   "sahne": "turler",
   "gecis": "karart",
   "gecisSure": 1.1,
   "start": 8.099269662921348,
   "end": 19.839831460674155,
   "konusma": {
    "start": 8.374269662921348,
    "end": 19.564831460674156
   },
   "cumleler": [
    {
     "metin": "Aslında iki tür gıdıklanma var.",
     "start": 8.374269662921348,
     "end": 10.22820224719101
    },
    {
     "metin": "Biri, tenimize tüy değmiş gibi hafif bir kaşıntı hissi.",
     "start": 10.54820224719101,
     "end": 13.907752808988763
    },
    {
     "metin": "Diğeri ise kaburgalarımıza ya da koltuk altımıza yapılan, bizi kahkahaya boğan gıdıklama.",
     "start": 14.227752808988763,
     "end": 19.564831460674156
    }
   ]
  },
  {
   "id": "beyin",
   "sahne": "beyin",
   "gecis": "karart",
   "gecisSure": 1.1,
   "start": 19.839831460674155,
   "end": 29.878370786516854,
   "konusma": {
    "start": 20.114831460674157,
    "end": 29.603370786516855
   },
   "cumleler": [
    {
     "metin": "Kendinize dokunduğunuzda beyniniz, özellikle de beyincik, bu hissi önceden tahmin ediyor ve etkisini azaltıyor.",
     "start": 20.114831460674157,
     "end": 26.800224719101124
    },
    {
     "metin": "Sürpriz olmayınca, gıdıklanma da olmuyor.",
     "start": 27.120224719101124,
     "end": 29.603370786516855
    }
   ]
  },
  {
   "id": "sosyal",
   "sahne": "sosyal",
   "gecis": "karart",
   "gecisSure": 1,
   "start": 29.878370786516854,
   "end": 48.168651685393264,
   "konusma": {
    "start": 30.153370786516856,
    "end": 45.56865168539326
   },
   "cumleler": [
    {
     "metin": "Bilim insanlarına göre gıdıklanma, oyun sırasında aramızdaki bağı güçlendiriyor olabilir.",
     "start": 30.153370786516856,
     "end": 35.44550561797753
    },
    {
     "metin": "Üstelik bu yalnızca bize özgü değil: Şempanzeler, hatta fareler bile gıdıklanınca gülmeye benzer sesler çıkarıyor.",
     "start": 35.76550561797753,
     "end": 42.641910112359554
    },
    {
     "metin": "Farelerin bu sesini ise kulağımız duyamıyor!",
     "start": 42.961910112359554,
     "end": 45.56865168539326
    }
   ]
  }
 ],
