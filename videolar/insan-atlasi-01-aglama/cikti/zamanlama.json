   },
   "cumleler": [
    {
     "metin": "Üstelik ağlamak yalnızca üzüntüyle ilgili değildir.",
     "start": 20.044269662921348,
     "end": 23.044269662921348
    },
    {
     "metin": "Yoğun stres, yorgunluk, hormonal değişimler ve bazen mutluluk bile gözyaşlarını tetikleyebilir.",
     "start": 23.364269662921348,
     "end": 29.083370786516852
    },
    {
     "metin": "Beynimiz duygularımızı düzenlerken ağlamak da bu deneyimin bir parçası olabilir.",
     "start": 29.403370786516852,
     "end": 34.12247191011236
