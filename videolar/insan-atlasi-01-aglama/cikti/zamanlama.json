   },
   "cumleler": [
    {
     "metin": "Bazen gün boyunca bastırdığımız duygular, fark etmediğimiz stres ve zihinsel yorgunluk birikir.",
     "start": 8.837191011235955,
     "end": 14.511348314606744
    },
    {
     "metin": "Gün içinde güçlü kalmaya çalışırken bedenimiz ve zihnimiz sessizce yorulabilir.",
