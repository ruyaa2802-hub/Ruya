   "cumleler": [
    {
     "metin": "Hiç korktuğunuzda veya ürperdiğinizde kollarınızdaki tüylerin aniden diken diken olduğunu fark ettiniz mi?",
     "start": 2.4,
     "end": 8.647191011235957
    },
    {
     "metin": "Peki vücudunuz bunu neden yapıyor?",
     "start": 8.967191011235958,
     "end": 10.989662921348318
    }
   ]
  },
  {
   "id": "deri",
   "sahne": "deri",
   "gecis": "karart",
   "gecisSure": 1.4,
   "start": 11.264662921348318,
   "end": 24.263651685393263,
   "konusma": {
    "start": 11.539662921348318,
    "end": 23.98865168539326
   },
   "cumleler": [
    {
     "metin": "Aslında derimizin altında, her kıl köküne bağlı küçücük kaslar bulunuyor.",
     "start": 11.539662921348318,
     "end": 15.93292134831461
    },
    {
     "metin": "Bunlara kıl dikleştirici kaslar deniyor.",
     "start": 16.252921348314608,
     "end": 18.61247191011236
    },
    {
     "metin": "Korktuğumuzda sinir sistemimiz bu kasları harekete geçiriyor ve tüylerimiz dikleşiyor.",
     "start": 18.932471910112362,
     "end": 23.98865168539326
    }
   ]
  },
  {
   "id": "evrim",
   "sahne": "evrim",
   "gecis": "karart",
   "gecisSure": 1.2,
   "start": 24.263651685393263,
   "end": 40.33005617977529,
   "konusma": {
    "start": 24.538651685393262,
    "end": 40.05505617977529
   },
   "cumleler": [
    {
     "metin": "Bu mekanizma aslında çok eski bir hayatta kalma yönteminden geliyor.",
     "start": 24.538651685393262,
     "end": 28.583595505617982
    },
    {
     "metin": "Atalarımızın vücut kılları kabardığında daha büyük ve korkutucu görünmelerine yardımcı oluyordu.",
     "start": 28.903595505617982,
     "end": 34.54404494382023
    },
    {
     "metin": "Aynı zamanda soğukta vücut çevresinde hava tabakası oluşturarak ısı kaybını azaltıyordu.",
     "start": 34.86404494382023,
     "end": 40.05505617977529
    }
   ]
  },
  {
   "id": "sonuc",
   "sahne": "sonuc",
   "gecis": "karart",
   "gecisSure": 1,
   "start": 40.33005617977529,
   "end": 56.14842696629215,
   "konusma": {
    "start": 40.60505617977529,
    "end": 53.54842696629215
   },
   "cumleler": [
    {
     "metin": "İnsanlar zamanla vücut kıllarının büyük bölümünü kaybetti.",
     "start": 40.60505617977529,
     "end": 44.02078651685394
    },
    {
     "metin": "Ama bu eski mekanizma hâlâ bizimle.",
     "start": 44.34078651685394,
     "end": 46.44191011235956
    },
    {
     "metin": "Yani korktuğumuzda tüylerimizin diken diken olması, vücudumuzun milyonlarca yıllık geçmişinden kalan küçük bir iz!",
     "start": 46.76191011235956,
     "end": 53.54842696629215
    }
   ]
  }
