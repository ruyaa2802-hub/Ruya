[
 {
  "start": 0.45,
  "end": 2.158,
  "text": "Bu küçücük canlı, kendi boyunun"
 },
 {
  "start": 2.158,
  "end": 4.637,
  "text": "100 katına ulaşan yüksekliklere sıçrayabilir!"
 },
 {
  "start": 4.85,
  "end": 8.118,
  "text": "Bazı pire türleri yalnızca birkaç milimetre uzunluğundadır."
 },
 {
  "start": 8.35,
  "end": 10.1,
  "text": "Buna rağmen sıçrama yükseklikleri"
 },
 {
  "start": 10.1,
  "end": 12.645,
  "text": "kendi boylarının yaklaşık 100 katına ulaşabilir."
 },
 {
  "start": 12.95,
  "end": 14.432,
  "text": "Peki bunu nasıl başarıyor?"
 },
 {
  "start": 14.65,
  "end": 16.266,
  "text": "Kasları enerji biriktirir."
 },
 {
  "start": 16.45,
  "end": 18.572,
  "text": "Piredeki esnek yapılar ve dış iskelet,"
 },
 {
  "start": 18.572,
  "end": 20.414,
  "text": "bir yaylı mekanizma gibi çalışır."
 },
 {
  "start": 20.6,
  "end": 22.735,
  "text": "Biriken enerji bir anda serbest kalır"
 },
 {
  "start": 22.735,
  "end": 25.216,
  "text": "ve pireyi adeta bir mancınık gibi fırlatır."
 },
 {
  "start": 25.55,
  "end": 27.532,
  "text": "Üstelik pirelerin kanatları yoktur!"
 },
 {
  "start": 27.75,
  "end": 29.645,
  "text": "Bir konakçı üzerinde hareket etmek"
 },
 {
  "start": 29.645,
  "end": 31.485,
  "text": "ve başka bir noktaya ulaşmak için"
 },
 {
  "start": 31.485,
  "end": 33.938,
  "text": "güçlü sıçrama yeteneklerinden yararlanırlar."
 },
 {
  "start": 34.4,
  "end": 36.629,
  "text": "Milimetrelik bir canlı, kendi boyuna göre"
 },
 {
  "start": 36.629,
  "end": 39.239,
  "text": "böylesine büyük bir sıçramayı nasıl yapabiliyor?"
 },
 {
  "start": 39.5,
  "end": 41.964,
  "text": "Doğanın mühendisliği gerçekten şaşırtıcı."
 }
]