[
 {
  "start": 0.35,
  "end": 1.84,
  "text": "Köpeğin aynada başka bir köpek"
 },
 {
  "start": 1.89,
  "end": 3.09,
  "text": "gördüğünü düşündün mü hiç?"
 },
 {
  "start": 3.45,
  "end": 5.9,
  "text": "Peki, neden onunla gerçek bir köpek gibi"
 },
 {
  "start": 5.95,
  "end": 6.75,
  "text": "iletişim kuramıyor?"
 },
 {
  "start": 7.4,
  "end": 9.74,
  "text": "Çünkü aynada bir görüntü var ama o"
 },
 {
  "start": 9.79,
  "end": 11.38,
  "text": "görüntüden gerçek bir koku gelmiyor."
 },
 {
  "start": 11.95,
  "end": 12.84,
  "text": "Köpekler için koku,"
 },
 {
  "start": 13.28,
  "end": 15.18,
  "text": "çevrelerindeki canlılar hakkında bilgi"
 },
 {
  "start": 15.23,
  "end": 16.8,
  "text": "edinmenin en önemli yollarından biri."
 },
 {
  "start": 17.4,
  "end": 19.91,
  "text": "Bir köpek, kokular sayesinde çevresindeki"
 },
 {
  "start": 19.96,
  "end": 22.27,
  "text": "canlılar hakkında pek çok ipucu edinebilir."
 },
 {
  "start": 22.75,
  "end": 24.01,
  "text": "Biz bir odaya baktığımızda"
 },
 {
  "start": 24.06,
  "end": 26.76,
  "text": "gördüklerimizi fark ederiz; o ise bizim"
 },
 {
  "start": 26.81,
  "end": 29.27,
  "text": "fark edemediğimiz koku bilgilerini de araştırır."
 },
 {
  "start": 29.8,
  "end": 31.34,
  "text": "Araştırmalar, köpeklerin kendi"
 },
 {
  "start": 31.39,
  "end": 33.05,
  "text": "kokularındaki değişikliklere tepki"
 },
 {
  "start": 33.1,
  "end": 34.1,
  "text": "verebildiğini gösteriyor."
 },
 {
  "start": 34.5,
  "end": 36.88,
  "text": "Yani aynada kendini tanıma testi, bir"
 },
 {
  "start": 36.93,
  "end": 38.6,
  "text": "köpeğin kendisi hakkında hiçbir"
 },
 {
  "start": 38.65,
  "end": 40.59,
  "text": "farkındalığı olmadığı anlamına gelmez."
 },
 {
  "start": 41.6,
  "end": 43.57,
  "text": "Belki de köpeklerin kendilerini"
 },
 {
  "start": 43.62,
  "end": 45.71,
  "text": "anlamlandırma biçimi bizimkinden farklıdır."
 },
 {
  "start": 46.4,
  "end": 48.35,
  "text": "Peki, sence köpeğin aynada kimi"
 },
 {
  "start": 48.4,
  "end": 49.14,
  "text": "gördüğünü düşünüyor?"
 }
]