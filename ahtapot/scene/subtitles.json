[
 {
  "start": 1.2,
  "end": 2.63,
  "text": "Bir ahtapotun tam üç kalbi"
 },
 {
  "start": 2.63,
  "end": 4.05,
  "text": "olduğunu biliyor muydun?"
 },
 {
  "start": 8.6,
  "end": 9.5,
  "text": "İki kalbi kanı"
 },
 {
  "start": 9.5,
  "end": 10.95,
  "text": "solungaçlara gönderir."
 },
 {
  "start": 11.6,
  "end": 12.6,
  "text": "Üçüncü kalbi ise"
 },
 {
  "start": 12.6,
  "end": 14.15,
  "text": "kanı vücuduna pompalar."
 },
 {
  "start": 18.2,
  "end": 19.7,
  "text": "Ahtapotlar oksijeni sudan"
 },
 {
  "start": 19.7,
  "end": 21.15,
  "text": "solungaçlarıyla alır."
 },
 {
  "start": 22.2,
  "end": 23.9,
  "text": "Üç kalbin görev paylaşımı,"
 },
 {
  "start": 23.9,
  "end": 26.05,
  "text": "kan dolaşımının bu sürecini destekler."
 },
 {
  "start": 31.0,
  "end": 32.05,
  "text": "Üstelik yüzmek,"
 },
 {
  "start": 32.05,
  "end": 33.67,
  "text": "ahtapotun sistemik kalbinin"
 },
 {
  "start": 33.67,
  "end": 35.05,
  "text": "atışını yavaşlatabilir."
 },
 {
  "start": 36.0,
  "end": 37.65,
  "text": "İşte bu yüzden"
 },
 {
  "start": 37.65,
  "end": 38.5,
  "text": "bu canlılar,"
 },
 {
  "start": 38.5,
  "end": 40.4,
  "text": "okyanusun en ilginç sakinlerinden biri!"
 }
]