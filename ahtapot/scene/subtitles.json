[
 {
  "start": 1.2,
  "end": 2.63,
  "text": "Bir ahtapotun tam üç kalbi"
 },
 {
  "start": 2.63,
  "end": 4.05,
  "text": "olduğunu biliyor muydun?"
 },
 {
  "start": 8.6,
  "end": 9.5,
  "text": "İki kalbi kanı"
 },
 {
  "start": 9.5,
  "end": 10.95,
  "text": "solungaçlara gönderir."
 },
 {
  "start": 11.6,
  "end": 12.6,
  "text": "Üçüncü kalbi ise"
 },
 {
  "start": 12.6,
  "end": 14.15,
  "text": "kanı vücuduna pompalar."
 },
 {
  "start": 18.2,
  "end": 19.7,
  "text": "Ahtapotlar oksijeni sudan"
 },
 {
  "start": 19.7,
  "end": 21.15,
  "text": "solungaçlarıyla alır."
 },
 {
  "start": 22.2,
  "end": 23.9,
  "text": "Üç kalbin görev paylaşımı,"
 },
 {
  "start": 23.9,
  "end": 26.05,
  "text": "kan dolaşımının bu sürecini destekler."
 },
 {
  "start": 26.5,
  "end": 28.84,
  "text": "Bu arada, ahtapotun kanı mavidir;"
 },
 {
  "start": 28.84,
  "end": 30.45,
  "text": "çünkü oksijeni,"
 },
 {
  "start": 30.45,
  "end": 32.2,
  "text": "bakır içeren hemosiyanin taşır."
 },
 {
  "start": 32.6,
  "end": 33.45,
  "text": "Bir bilgi daha:"
 },
 {
  "start": 33.85,
  "end": 35.65,
  "text": "Ahtapotlar, derilerindeki"
 },
 {
  "start": 35.65,
  "end": 37.4,
  "text": "renk hücreleri sayesinde"
 },
 {
  "start": 37.4,
  "end": 39.15,
  "text": "göz açıp kapayana kadar renk değiştirebilir."
 },
 {
  "start": 40.0,
  "end": 42.3,
  "text": "Dahası, sinir hücrelerinin yaklaşık"
 },
 {
  "start": 42.3,
  "end": 43.85,
  "text": "üçte ikisi kollarındadır."
 },
 {
  "start": 43.95,
  "end": 45.3,
  "text": "Bu yüzden her kol,"
 },
 {
  "start": 45.3,
  "end": 47.6,
  "text": "bazı hareketleri kendi başına yönetebilir!"
 },
 {
  "start": 48.2,
  "end": 49.25,
  "text": "Üstelik yüzmek,"
 },
 {
  "start": 49.25,
  "end": 50.87,
  "text": "ahtapotun sistemik kalbinin"
 },
 {
  "start": 50.87,
  "end": 52.25,
  "text": "atışını yavaşlatabilir."
 },
 {
  "start": 53.2,
  "end": 54.85,
  "text": "İşte bu yüzden"
 },
 {
  "start": 54.85,
  "end": 55.7,
  "text": "bu canlılar,"
 },
 {
  "start": 55.7,
  "end": 57.6,
  "text": "okyanusun en ilginç sakinlerinden biri!"
 }
]