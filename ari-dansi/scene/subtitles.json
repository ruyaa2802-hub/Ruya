[
 {
  "start": 1.2,
  "end": 3.5,
  "text": "Bir arının çiçek tarlası bulduğunu düşün."
 },
 {
  "start": 4.2,
  "end": 6.8,
  "text": "Peki, arkadaşlarına yolu nasıl anlatır?"
 },
 {
  "start": 9.7,
  "end": 11.7,
  "text": "İşte sırrı: Dans ederek!"
 },
 {
  "start": 12.1,
  "end": 14.55,
  "text": "Bal arıları, özel bir sallanma dansıyla"
 },
 {
  "start": 14.55,
  "end": 18.1,
  "text": "diğer arılara besinin yönü ve uzaklığı hakkında bilgi verir."
 },
 {
  "start": 18.8,
  "end": 20.2,
  "text": "Dansın yönü, güneşe göre"
 },
 {
  "start": 20.2,
  "end": 22.65,
  "text": "hangi tarafa uçmaları gerektiğini anlatır."
 },
 {
  "start": 24.6,
  "end": 25.86,
  "text": "Dansın süresi ise"
 },
 {
  "start": 25.86,
  "end": 28.8,
  "text": "ne kadar uzağa gitmeleri gerektiği hakkında ipucu verir."
 },
 {
  "start": 31.8,
  "end": 33.33,
  "text": "Yani bu minik canlılar,"
 },
 {
  "start": 33.33,
  "end": 36.1,
  "text": "kovanda adeta dans ederek konum paylaşıyor!"
 },
 {
  "start": 37.0,
  "end": 39.98,
  "text": "Doğanın en şaşırtıcı iletişim yöntemlerinden biri,"
 },
 {
  "start": 39.98,
  "end": 41.2,
  "text": "değil mi?"
 }
]