[
 {
  "start": 0.25,
  "end": 2.17,
  "html": "Deniz altında öyle bir <b>baba</b> var ki,",
  "text": "Deniz altında öyle bir baba var ki,"
 },
 {
  "start": 2.55,
  "end": 3.9899999999999998,
  "html": "<b>doğum yapan</b> taraf o!",
  "text": "doğum yapan taraf o!"
 },
 {
  "start": 4.01,
  "end": 5.8500000000000005,
  "html": "Evet, evet, yanlış duymadın!",
  "text": "Evet, evet, yanlış duymadın!"
 },
 {
  "start": 5.87,
  "end": 7.210000000000001,
  "html": "Deniz atlarında <b>dişi</b>,",
  "text": "Deniz atlarında dişi,"
 },
 {
  "start": 7.23,
  "end": 8.63,
  "html": "<b>yumurtalarını</b> erkeğin karnındaki",
  "text": "yumurtalarını erkeğin karnındaki"
 },
 {
  "start": 8.65,
  "end": 9.95,
  "html": "özel bir <b>keseye</b> bırakıyor.",
  "text": "özel bir keseye bırakıyor."
 },
 {
  "start": 10.55,
  "end": 11.71,
  "html": "<b>Baba adayımız</b> da yumurtaları",
  "text": "Baba adayımız da yumurtaları"
 },
 {
  "start": 11.73,
  "end": 12.65,
  "html": "burada <b>taşıyor</b>,",
  "text": "burada taşıyor,"
 },
 {
  "start": 12.67,
  "end": 13.71,
  "html": "<b>gelişmelerini</b> sağlıyor",
  "text": "gelişmelerini sağlıyor"
 },
 {
  "start": 13.73,
  "end": 15.21,
  "html": "ve <b>doğum</b> zamanı gelince…",
  "text": "ve doğum zamanı gelince…"
 },
 {
  "start": 15.23,
  "end": 16.45,
  "html": "<b>minik deniz atlarını</b>",
  "text": "minik deniz atlarını"
 },
 {
  "start": 16.47,
  "end": 17.33,
  "html": "dünyaya getiriyor!",
  "text": "dünyaya getiriyor!"
 },
 {
  "start": 17.71,
  "end": 18.75,
  "html": "Ama dur, daha bitmedi!",
  "text": "Ama dur, daha bitmedi!"
 },
 {
  "start": 19.33,
  "end": 20.71,
  "html": "Bazı türler tek seferde",
  "text": "Bazı türler tek seferde"
 },
 {
  "start": 20.73,
  "end": 22.07,
  "html": "<b>yüzlerce yavru</b> doğurabiliyor.",
  "text": "yüzlerce yavru doğurabiliyor."
 },
 {
  "start": 22.51,
  "end": 22.97,
  "html": "Düşünsene,",
  "text": "Düşünsene,"
 },
 {
  "start": 23.39,
  "end": 25.47,
  "html": "koca bir <b>aile</b> bir anda ortaya çıkıyor!",
  "text": "koca bir aile bir anda ortaya çıkıyor!"
 },
 {
  "start": 25.49,
  "end": 26.53,
  "html": "Peki ya <b>aşk</b> hayatları?",
  "text": "Peki ya aşk hayatları?"
 },
 {
  "start": 26.55,
  "end": 28.57,
  "html": "Bazı deniz atı türleri,",
  "text": "Bazı deniz atı türleri,"
 },
 {
  "start": 28.59,
  "end": 29.71,
  "html": "<b>aynı eşle</b> birden fazla",
  "text": "aynı eşle birden fazla"
 },
 {
  "start": 29.73,
  "end": 31.35,
  "html": "üreme döneminde birlikte kalabiliyor.",
  "text": "üreme döneminde birlikte kalabiliyor."
 },
 {
  "start": 31.81,
  "end": 33.529999999999994,
  "html": "Hatta birbirlerini <b>selamlamak</b> için,",
  "text": "Hatta birbirlerini selamlamak için,"
 },
 {
  "start": 33.55,
  "end": 34.809999999999995,
  "html": "her gün <b>dans</b> eder gibi",
  "text": "her gün dans eder gibi"
 },
 {
  "start": 34.83,
  "end": 36.11,
  "html": "hareketler yapabiliyorlar!",
  "text": "hareketler yapabiliyorlar!"
 },
 {
  "start": 36.53,
  "end": 37.83,
  "html": "Kısacası deniz altında",
  "text": "Kısacası deniz altında"
 },
 {
  "start": 37.85,
  "end": 39.129999999999995,
  "html": "hem <b>sıra dışı babalar</b>,",
  "text": "hem sıra dışı babalar,"
 },
 {
  "start": 39.15,
  "end": 40.35,
  "html": "hem de <b>romantik danslar</b> var.",
  "text": "hem de romantik danslar var."
 },
 {
  "start": 40.75,
  "end": 42.51,
  "html": "Doğanın <b>sürprizleri</b> gerçekten bitmiyor!",
  "text": "Doğanın sürprizleri gerçekten bitmiyor!"
 },
 {
  "start": 43.15,
  "end": 45.07,
  "html": "Peki sence, <b>yavrulara</b> bakma işini",
  "text": "Peki sence, yavrulara bakma işini"
 },
 {
  "start": 45.09,
  "end": 46.87,
  "html": "başka hangi hayvan <b>babalar</b> üstleniyor?",
  "text": "başka hangi hayvan babalar üstleniyor?"
 },
 {
  "start": 47.23,
  "end": 47.85,
  "html": "<b>Yorumlara yaz!</b>",
  "text": "Yorumlara yaz!"
 }
]