[
 {
  "start": 0.3,
  "end": 1.96,
  "html": "Ya sana, kaybettiği bir <b>bacağını</b>",
  "text": "Ya sana, kaybettiği bir bacağını"
 },
 {
  "start": 1.98,
  "end": 3.28,
  "html": "<b>yeniden oluşturabilen</b> bir hayvan",
  "text": "yeniden oluşturabilen bir hayvan"
 },
 {
  "start": 3.3,
  "end": 4.4,
  "html": "olduğunu söylesem?",
  "text": "olduğunu söylesem?"
 },
 {
  "start": 4.42,
  "end": 6.04,
  "html": "Üstelik bu, <b>bilim kurgu değil!</b>",
  "text": "Üstelik bu, bilim kurgu değil!"
 },
 {
  "start": 6.4,
  "end": 7.920000000000001,
  "html": "<b>Aksolotl</b>, kaybettiği bacaklarını",
  "text": "Aksolotl, kaybettiği bacaklarını"
 },
 {
  "start": 7.94,
  "end": 8.96,
  "html": "<b>yeniden oluşturabiliyor!</b>",
  "text": "yeniden oluşturabiliyor!"
 },
 {
  "start": 9.42,
  "end": 10.66,
  "html": "Hem de yalnızca derisini değil;",
  "text": "Hem de yalnızca derisini değil;"
 },
 {
  "start": 11.08,
  "end": 12.38,
  "html": "<b>kemiklerini</b>, <b>kaslarını</b>,",
  "text": "kemiklerini, kaslarını,"
 },
 {
  "start": 12.76,
  "end": 13.92,
  "html": "<b>sinirlerini</b> ve <b>damarlarını</b> da",
  "text": "sinirlerini ve damarlarını da"
 },
 {
  "start": 13.94,
  "end": 14.98,
  "html": "yeniden geliştirebiliyor.",
  "text": "yeniden geliştirebiliyor."
 },
 {
  "start": 15.34,
  "end": 16.32,
  "html": "Peki bunu nasıl yapıyor?",
  "text": "Peki bunu nasıl yapıyor?"
 },
 {
  "start": 16.76,
  "end": 17.740000000000002,
  "html": "Yaralanan bölgede,",
  "text": "Yaralanan bölgede,"
 },
 {
  "start": 17.76,
  "end": 18.92,
  "html": "<b>blastema</b> adı verilen",
  "text": "blastema adı verilen"
 },
 {
  "start": 18.94,
  "end": 20.46,
  "html": "özel bir <b>hücre yapısı</b> oluşuyor.",
  "text": "özel bir hücre yapısı oluşuyor."
 },
 {
  "start": 20.94,
  "end": 22.080000000000002,
  "html": "Bu hücreler <b>çoğalarak</b>,",
  "text": "Bu hücreler çoğalarak,"
 },
 {
  "start": 22.1,
  "end": 24.28,
  "html": "<b>yeni dokuların</b> gelişmesini sağlıyor.",
  "text": "yeni dokuların gelişmesini sağlıyor."
 },
 {
  "start": 24.3,
  "end": 26.06,
  "html": "Bir başka şaşırtıcı özelliği daha var!",
  "text": "Bir başka şaşırtıcı özelliği daha var!"
 },
 {
  "start": 26.08,
  "end": 28.22,
  "html": "Aksolotl <b>yetişkinliğe</b> ulaşsa bile,",
  "text": "Aksolotl yetişkinliğe ulaşsa bile,"
 },
 {
  "start": 28.24,
  "end": 30.68,
  "html": "<b>yavruluk dönemine</b> ait özelliklerini koruyor.",
  "text": "yavruluk dönemine ait özelliklerini koruyor."
 },
 {
  "start": 31.2,
  "end": 32.199999999999996,
  "html": "Başının iki yanındaki",
  "text": "Başının iki yanındaki"
 },
 {
  "start": 32.22,
  "end": 33.459999999999994,
  "html": "<b>tüylü solungaçlar</b>,",
  "text": "tüylü solungaçlar,"
 },
 {
  "start": 33.48,
  "end": 35.0,
  "html": "bunun en güzel kanıtı.",
  "text": "bunun en güzel kanıtı."
 },
 {
  "start": 35.02,
  "end": 36.279999999999994,
  "html": "Ancak bu eşsiz canlı,",
  "text": "Ancak bu eşsiz canlı,"
 },
 {
  "start": 36.3,
  "end": 38.3,
  "html": "doğal yaşam alanı olan <b>Meksika</b>&#x27;da,",
  "text": "doğal yaşam alanı olan Meksika'da,"
 },
 {
  "start": 38.32,
  "end": 40.459999999999994,
  "html": "<b>yok olma tehlikesiyle</b> karşı karşıya.",
  "text": "yok olma tehlikesiyle karşı karşıya."
 },
 {
  "start": 40.48,
  "end": 41.519999999999996,
  "html": "Doğanın bize sunduğu",
  "text": "Doğanın bize sunduğu"
 },
 {
  "start": 41.54,
  "end": 43.4,
  "html": "bu <b>mucizeyi korumak</b> zorundayız.",
  "text": "bu mucizeyi korumak zorundayız."
 },
 {
  "start": 43.42,
  "end": 44.58,
  "html": "Sen, böyle bir canlı",
  "text": "Sen, böyle bir canlı"
 },
 {
  "start": 44.6,
  "end": 45.56,
  "html": "olduğunu <b>biliyor muydun?</b>",
  "text": "olduğunu biliyor muydun?"
 }
]