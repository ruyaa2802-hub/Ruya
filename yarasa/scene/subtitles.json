[
 {
  "start": 0.7,
  "end": 2.5,
  "text": "Göz gözü görmeyen bir karanlıkta,"
 },
 {
  "start": 2.91,
  "end": 5.38,
  "text": "bu yarasa küçücük bir böceği nasıl bulabiliyor?"
 },
 {
  "start": 5.7,
  "end": 7.52,
  "text": "Sırrı, bizim duyamadığımız kadar"
 },
 {
  "start": 7.52,
  "end": 9.08,
  "text": "yüksek frekanslı seslerde:"
 },
 {
  "start": 9.35,
  "end": 10.3,
  "text": "ultrasonlarda!"
 },
 {
  "start": 12.5,
  "end": 13.72,
  "text": "Yarasa ses gönderiyor."
 },
 {
  "start": 13.9,
  "end": 15.77,
  "text": "Ses bir engele çarpıp geri dönüyor."
 },
 {
  "start": 16.6,
  "end": 17.91,
  "text": "Yarasa da yankıyı dinliyor."
 },
 {
  "start": 22.2,
  "end": 24.49,
  "text": "Yankının ne kadar sürede döndüğünü"
 },
 {
  "start": 24.49,
  "end": 25.84,
  "text": "ve nasıl değiştiğini"
 },
 {
  "start": 26.1,
  "end": 27.57,
  "text": "analiz ederek, nesnenin uzaklığını,"
 },
 {
  "start": 27.57,
  "end": 29.13,
  "text": "yönünü ve hareketini anlayabiliyor."
 },
 {
  "start": 33.4,
  "end": 35.56,
  "text": "Yani yarasa, çevresinin seslerden oluşan"
 },
 {
  "start": 35.56,
  "end": 36.97,
  "text": "bir haritasını çıkarıyor."
 },
 {
  "start": 37.5,
  "end": 40.18,
  "text": "Karanlık onun için tamamen kör olmak demek değil!"
 }
]