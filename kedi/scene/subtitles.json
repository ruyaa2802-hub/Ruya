[
 {
  "start": 0.75,
  "end": 1.71,
  "text": "Hiç düşündün mü?"
 },
 {
  "start": 2.25,
  "end": 3.9,
  "text": "Kediler birbirlerine değil de,"
 },
 {
  "start": 3.9,
  "end": 5.92,
  "text": "bize neden bu kadar çok miyavlıyor?"
 },
 {
  "start": 7.0,
  "end": 9.35,
  "text": "Yetişkin kediler kendi aralarında çoğunlukla"
 },
 {
  "start": 9.35,
  "end": 11.51,
  "text": "beden dili ve koku sinyallerini kullanır."
 },
 {
  "start": 12.85,
  "end": 15.22,
  "text": "Miyavlama ise insanlarla iletişimlerinde"
 },
 {
  "start": 15.22,
  "end": 16.49,
  "text": "özellikle yaygındır."
 },
 {
  "start": 17.4,
  "end": 19.26,
  "text": "Zamanla kediler şunu öğrenebilir:"
 },
 {
  "start": 20.0,
  "end": 22.03,
  "text": "Miyavladığımda insanım bana bakıyor,"
 },
 {
  "start": 22.03,
  "end": 24.06,
  "text": "kapıyı açıyor ya da yemek veriyor."
 },
 {
  "start": 27.0,
  "end": 29.26,
  "text": "Üstelik her miyav aynı anlama gelmez."
 },
 {
  "start": 29.95,
  "end": 32.29,
  "text": "Açlık, ilgi isteği veya rahatsızlık,"
 },
 {
  "start": 32.29,
  "end": 34.36,
  "text": "farklı seslerle ifade edilebilir."
 },
 {
  "start": 35.0,
  "end": 37.9,
  "text": "Kedinin beden diline ve bulunduğu ortama da bakmalıyız."
 },
 {
  "start": 39.2,
  "end": 41.29,
  "text": "Yani kedin sana miyavladığında, belki de"
 },
 {
  "start": 41.29,
  "end": 44.18,
  "text": "seninle kurduğu özel iletişim dilini kullanıyordur."
 },
 {
  "start": 44.75,
  "end": 47.59,
  "text": "Peki, senin kedin en çok ne zaman miyavlıyor?"
 }
]